FROM tianon/gosu:1.19-trixie@sha256:3b176695959c71e123eb390d427efc665eeb561b1540e82679c15e992006b8b9 AS gosu_source
FROM debian:13.4

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python3-venv \
    build-essential cmake \
    curl \
    nodejs npm \
    libolm-dev \
    libffi-dev \
    libsodium-dev \
    libopus0 libopus-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (static binary) so the terminal tool can spawn sandbox containers
RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.5.1.tgz \
    | tar xz --strip-components=1 -C /usr/local/bin docker/docker

COPY --chmod=0755 --from=gosu_source /gosu /usr/local/bin/

RUN useradd -u 10000 -m -d /opt/data hermes

COPY . /opt/hermes
WORKDIR /opt/hermes

RUN python3 -m venv .venv && \
    .venv/bin/pip install --no-cache-dir -e ".[messaging,matrix,cron,homeassistant,sms,dingtalk,feishu,slack,mcp,honcho]"

RUN npm install -g agent-browser && agent-browser install --with-deps

RUN chmod +x /opt/hermes/docker/entrypoint.sh

ENV HERMES_HOME=/opt/data
VOLUME [ "/opt/data" ]
ENTRYPOINT [ "/opt/hermes/docker/entrypoint.sh" ]
