FROM nikolaik/python-nodejs:python3.11-nodejs20

# Install Docker CLI so agents can run docker commands via the mounted socket
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

# Install git and common dev tools
RUN apt-get update && apt-get install -y --no-install-recommends git curl && rm -rf /var/lib/apt/lists/*

# Configure git to use GITHUB_TOKEN env var for authentication
RUN git config --global user.name "Hermes-agent" \
    && git config --global user.email "noreply" \
    && git config --global credential.helper '!f() { echo "username=x-access-token"; echo "password=${GITHUB_TOKEN}"; }; f'

# Install RTK (Rust Token Killer) - reduces LLM token usage 60-90%
# by compressing command output (git, ls, pytest, docker, etc.)
ARG RTK_VERSION=0.34.3
RUN curl -fsSL "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/rtk-x86_64-unknown-linux-musl.tar.gz" \
    | tar xz -C /usr/local/bin \
    && chmod +x /usr/local/bin/rtk \
    && rtk init -g
